# Code-only repository: ignore top-level content unless explicitly allowed.
# This excludes data/, additional_input/, models/, vendor/, results/, reports/,
# deliverables/, audit/, archive/, tmp/, paper/, docs/ and local research briefs.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE.*
!/scripts/
!/tests/
!/src/
!/app/
!/web/
!/config/
!/.github/

# Source/build configuration (allow these if added later).
!/pyproject.toml
!/requirements*.txt
!/requirements*.in
!/uv.lock
!/poetry.lock
!/setup.py
!/setup.cfg
!/pytest.ini
!/tox.ini
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/yarn.lock
!/tsconfig*.json
!/Dockerfile
!/Dockerfile.*
!/compose.y*ml
!/docker-compose*.y*ml
!/.dockerignore
!/Makefile
!/.pre-commit-config.yaml
!/.editorconfig

# Credentials and local machine configuration, including inside source folders.
.env
.env.*
*.env
**/credentials*.json
**/secrets*.json
**/service-account*.json
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc

# Environments, dependencies, caches and build products anywhere in the tree.
.venv*/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/
*.egg-info/
.eggs/
build/
dist/
coverage/
htmlcov/
.coverage*
*.log
*.tmp
*.part
*.incomplete
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.idea/
.vscode/

# Datasets, extracted poses, trained weights and packaged outputs.
*.csv
*.tsv
*.jsonl
*.ndjson
*.npy
*.npz
*.parquet
*.arrow
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tflite
*.bin
*.zip
*.tar
*.tar.*
*.tgz
*.gz
*.7z
*.rar
*.pdf
*.docx
*.xlsx
*.pptx

# Media and generated browser-data bundles are not source code.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wav
*.mp3
*.m4a
*.flac
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.ttf
*.otf
*.woff
*.woff2
offline-data.js
paper-results.js
points.js
*.min.js
*.bundle.js
*.map
